---
# Source: bluespice/templates/wiki-services-ingress.yaml
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: bluespice
  namespace: bluespice
  labels:
    helm.sh/chart: bluespice-1.0.0
    app.kubernetes.io/name: bluespice
    app.kubernetes.io/instance: bluespice
    app.kubernetes.io/version: "5.1"
    app.kubernetes.io/managed-by: Helm
spec:
  rules:
  - host: localhost
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: wiki-web
            port:
              name: http
      - path: /_collabpads
        pathType: Prefix
        backend:
          service:
            name: collabpads
            port:
              name: http
      - path: /_diagram
        pathType: Prefix
        backend:
          service:
            name: diagram
            port:
              name: http
  tls:
  - hosts:
    - localhost
    secretName: wiki-ingress-cert
---
# Source: bluespice/templates/wiki-install-job.yaml
apiVersion: batch/v1
kind: Job
metadata:
  name: bluespice-install
  namespace: bluespice
  labels:
    helm.sh/chart: bluespice-1.0.0
    app.kubernetes.io/name: bluespice
    app.kubernetes.io/instance: bluespice
    app.kubernetes.io/version: "5.1"
    app.kubernetes.io/managed-by: Helm
  annotations:
    "helm.sh/hook": post-install
    "helm.sh/hook-weight": "0"
    # keep job around after success so kubectl wait and log inspection still work
    "helm.sh/hook-delete-policy": before-hook-creation
spec:
  backoffLimit: 2
  template:
    spec:
      restartPolicy: OnFailure
      enableServiceLinks: false
      initContainers:
        - name: wait-for-db
          image: busybox
          command: ['sh', '-c', 'until nc -z database 3306; do echo waiting for database; sleep 5; done;']
      containers:
        - name: run-installation
          image: bluespice/wiki:5.2
          imagePullPolicy: IfNotPresent
          command: ["/app/bin/run-installation"]
          envFrom:
            - configMapRef:
                name: bluespice-wiki-config
            - secretRef:
                name: internal-wiki-secrets
          env:
            - name: DB_PASS
              valueFrom:
                secretKeyRef:
                  name: bluespice-database-secrets
                  key: MARIADB_PASSWORD
          volumeMounts:
            - name: wiki
              mountPath: /data
              subPath: wiki
      volumes:
        - name: wiki
          persistentVolumeClaim:
            claimName: wiki-pvc
