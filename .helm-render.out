# Source: bluespice/templates/wiki-services-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: wiki-web
  namespace: bluespice
  labels:
    app: wiki-web
    helm.sh/chart: bluespice-1.0.0
    app.kubernetes.io/name: bluespice
    app.kubernetes.io/instance: bluespice
    app.kubernetes.io/version: "5.1"
    app.kubernetes.io/managed-by: Helm
spec:
  replicas: 1
  selector:
    matchLabels:
      app: wiki-web
  template:
    metadata:
      labels:
        app: wiki-web
        app.kubernetes.io/name: bluespice
        app.kubernetes.io/instance: bluespice
    spec:
      enableServiceLinks: false
      initContainers:
        - name: wait-for-db
          image: busybox
          command: ['sh', '-c', 'until nc -z database 3306; do echo waiting for database; sleep 5; done;']
      containers:
      - name: wiki-web
        image: bluespice/wiki:5.2
        imagePullPolicy: IfNotPresent
        args:
          - start-web
        envFrom:
          - configMapRef:
              name: bluespice-wiki-config
        env:
          - name: DB_PASS
            valueFrom:
              secretKeyRef:
                name: bluespice-database-secrets
                key: MARIADB_PASSWORD
        ports:
          - name: http 
            containerPort: 9090
            protocol: TCP
        volumeMounts:
        - name: wiki
          mountPath: /data
      - name: wiki-task
        image: bluespice/wiki:5.2
        imagePullPolicy: IfNotPresent
        args:
          - start-task --runAll
        envFrom:
          - configMapRef:
              name: bluespice-wiki-config
        env:
          - name: BACKUP_HOUR
            value: "02"
          - name: DB_PASS
            valueFrom:
              secretKeyRef:
                name: bluespice-database-secrets
                key: MARIADB_PASSWORD
        volumeMounts:
        - name: wiki
          mountPath: /data
      volumes:
      - name: wiki
        persistentVolumeClaim:
          claimName: wiki-pvc
---
# Source: bluespice/templates/wiki-stateful-backend-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: collabpads-database
  namespace: bluespice
  labels:
    app: collabpads-database
spec:
  replicas: 1
  selector:
    matchLabels:
      app: collabpads-database
  template:
    metadata:
      labels:
        app: collabpads-database
    spec:
      containers:
      - name: collabpads-database
        image: "mongo:8.2"
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 27017
        volumeMounts:
        - name: collabpads-pvc
          mountPath: /data/db
      volumes:
      - name: collabpads-pvc
        persistentVolumeClaim:
          claimName: collabpads-pvc
---
# Source: bluespice/templates/wiki-stateful-backend-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: database
  namespace: bluespice
  labels:
    app: database
spec:
  replicas: 1
  selector:
    matchLabels:
      app: database
  template:
    metadata:
      labels:
        app: database
    spec:
      containers:
      - name: database
        image: "mariadb:10.5"
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 3306
        env:
          - name: MARIADB_DATABASE
            value: bluespice
          - name: MARIADB_USER
            value: bluespice
        envFrom:
        - secretRef:
            name: bluespice-database-secrets
        volumeMounts:
        - name: database-data-pvc
          mountPath: /var/lib/mysql
        - name: database-logs-pvc
          mountPath: /var/log/mysql
      volumes:
      - name: database-data-pvc
        persistentVolumeClaim:
          claimName: database-data-pvc
      - name: database-logs-pvc
        persistentVolumeClaim:
          claimName: database-logs-pvc
---
